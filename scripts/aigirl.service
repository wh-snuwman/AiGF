# systemd 서비스 예시.
# 1) 아래 User, WorkingDirectory, ExecStart 경로를 실제 값으로 수정
# 2) sudo cp scripts/aigirl.service /etc/systemd/system/aigirl.service
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now aigirl
# 로그 확인: journalctl -u aigirl -f
[Unit]
Description=AI Girl Discord Bot
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/PR_AIgirl
ExecStart=/home/YOUR_USER/PR_AIgirl/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
